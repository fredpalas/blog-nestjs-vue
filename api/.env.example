# Base de datos (compose.yaml de la raíz levanta este Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=!ChangeMe!
DB_NAME=app

PORT=3000
NODE_ENV=production

# Origen permitido para el frontend. "*" vale para la demo; en algo serio,
# el dominio concreto.
CORS_ORIGIN=*

# Workers de cluster. Sin declararlo: uno por CPU con tope de 2.
# CLUSTER_WORKERS=2

# OTel apagado salvo que se ponga explícitamente a "true" (ver src/tracing.ts)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=blog-api
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
